{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dashwheel: installGithubDebug",
      "type": "shell",
      "command": ".\\gradlew.bat :app:installGithubDebug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      }
    },
    {
      "label": "dashwheel: start MainActivity",
      "type": "shell",
      "command": "adb shell am start -n com.mydashwheel.dash/.MainActivity",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      }
    },
    {
      "label": "dashwheel: release github (APK firmado)",
      "type": "shell",
      "command": ".\\gradlew.bat :app:assembleGithubRelease :companion:assembleGithubRelease",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      }
    },
    {
      "label": "dashwheel: release play (AAB + APK firmados)",
      "type": "shell",
      "command": ".\\gradlew.bat :app:bundlePlayRelease :app:assemblePlayRelease :companion:bundlePlayRelease",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      }
    },
    {
      "label": "dashwheel: install + launch",
      "dependsOrder": "sequence",
      "dependsOn": [
        "dashwheel: installGithubDebug",
        "dashwheel: start MainActivity"
      ],
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
